{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "inputs": [
        {
          "local": true,
          "include": ["."]
        }
      ],
      "commands": [
        "pnpm install --no-frozen-lockfile --prefer-offline",
        "PATH:node_modules/.bin"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm start"
  }
}
